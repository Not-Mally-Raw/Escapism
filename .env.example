# =============================================================================
# Groq API Key Pool Configuration (Track 2 Semantic Diagnostics)
# You can paste multiple keys either as a comma-separated list or numbered slots.
# =============================================================================

# Option A: Comma-separated pool
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Option B: Individual numbered keys (auto-detected 1..10)
GROQ_API_KEY_1=gsk_key1_here
GROQ_API_KEY_2=gsk_key2_here
GROQ_API_KEY_3=gsk_key3_here
GROQ_API_KEY_4=gsk_key4_here
GROQ_API_KEY_5=gsk_key5_here

# Model Configuration
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Razorpay Test Mode Credentials (for Stage 5)
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
